# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Isolated payment-test: copy .env.payment-test.example → .env.payment-test.local
# (gitignored) and run `npm run dev:payment-test`. Do not put TEST Toss keys in this file
# while VITE_SUPABASE_URL still points at production.

# GA4 (public Measurement ID — not a secret). Local/dev override only.
# Production uses BAKED_GA4_MEASUREMENT_ID in src/lib/ga4.ts (Docker does not pass VITE_*).
VITE_GA4_MEASUREMENT_ID=
# Optional: console debug + GA4 DebugView (debug_mode=true). Never set in prod traffic.
# VITE_ANALYTICS_DEBUG=true

# Toss Payments
TOSS_SECRET_KEY=

# Discord
DISCORD_WEBHOOK_URL=

# SEO
BASE_URL=https://metalora.art

# NEW4-6 Workshop retention job (scheduler NOT configured in NEW4-6).
# Name only — never commit the value. Min 32 chars. Required before enabling hourly purge.
# WORKSHOP_RETENTION_JOB_SECRET=

# NEW4-4D Workshop private GCS (not yet used by the app; bind with the server adapter deploy).
# Non-secret identifiers only. No credentials or keys — the runtime SA impersonates the signer SA.
# WORKSHOP_GCS_BUCKET=metalora-workshop-apne3
# WORKSHOP_GCS_ENDPOINT=https://storage.asia-northeast3.rep.googleapis.com
# WORKSHOP_GCS_SIGNER_SA=workshop-media-signer@metalora-auth.iam.gserviceaccount.com

# Production OTP SMS (names only — never commit values)
# SMS_ADAPTER=solapi
# SOLAPI_API_KEY=
# SOLAPI_API_SECRET=
# SMS_SENDER_NUMBER=
