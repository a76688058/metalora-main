# NEW4-4D-9D-1 — Workshop legacy METADATA-ONLY inventory job image (Cloud Run Job, asia-northeast3).
# Build only from a clean `git archive` of a committed HEAD. No secrets at build time; the Supabase
# service-role key arrives at run time as a Secret Manager env reference.
FROM node:22-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production

COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force

COPY src/lib/workshopStorage.ts ./src/lib/
COPY scripts/workshop-legacy-copy-core.ts scripts/workshop-legacy-copy.ts scripts/workshop-metadata-inventory-job.ts ./scripts/

USER node

ENTRYPOINT ["./node_modules/.bin/tsx", "scripts/workshop-metadata-inventory-job.ts"]
