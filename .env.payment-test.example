# Isolated payment-test environment (#18C)
# Copy this file to .env.payment-test.local (gitignored) and fill TEST values only.
# Never put production secrets or live Toss keys here.
# Never commit .env.payment-test.local.

METALORA_ENV=payment-test
VITE_METALORA_ENV=payment-test

# Isolated project: metalora-payment-test (NOT production)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Toss Payments TEST secret only (test_sk_ / test_gsk_)
TOSS_SECRET_KEY=

# NEW4-6 Workshop retention job (scheduler NOT configured in NEW4-6).
# Name only — never commit the value. Min 32 chars.
# WORKSHOP_RETENTION_JOB_SECRET=

# Slice A verified-phone / OTP (names only — never put real key values here)
PHONE_IDENTITY_KEY=
OTP_PEPPER=
SMS_ADAPTER=

# Isolated Workshop GCS. Payment-test accepts only this bucket and signer.
# Absent or partial: Workshop media routes return 503. Checkout still starts.
# No service-account keys belong in this file.
WORKSHOP_GCS_BUCKET=metalora-workshop-test-apne3
WORKSHOP_GCS_ENDPOINT=https://storage.asia-northeast3.rep.googleapis.com
WORKSHOP_GCS_SIGNER_SA=workshop-media-signer-test@metalora-auth.iam.gserviceaccount.com
